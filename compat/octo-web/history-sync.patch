index 0000000000000000000000000000000000000000..73b32b5133d91fac531675d7c52f4d50df23076f
--- /dev/null
+++ b/packages/dmworkbase/src/Components/Conversation/historySnapshot.ts
@@ -0,0 +1,150 @@
+/** Request-scoped reconciliation only: never copy the entire old history window. */
+export interface SnapshotMessage {
+    clientMsgNo?: string
+    messageID?: string
+    messageSeq?: number
+    isDeleted?: boolean
+    revoke?: boolean
+    revoker?: string
+}
+
+function validSeq(seq: number | undefined): seq is number {
+    return typeof seq === "number" && Number.isSafeInteger(seq) && seq > 0
+}
+
+function keys(message: SnapshotMessage): string[] {
+    const result: string[] = []
+    if (message.clientMsgNo) result.push(`client:${message.clientMsgNo}`)
+    if (message.messageID) result.push(`id:${message.messageID}`)
+    if (validSeq(message.messageSeq)) result.push(`seq:${message.messageSeq}`)
+    return result
+}
+
+export function sameSnapshotMessage(a: SnapshotMessage, b: SnapshotMessage): boolean {
+    // A weaker key cannot override a disagreement between stronger identities.
+    if (a.messageID && b.messageID) return a.messageID === b.messageID
+    if (validSeq(a.messageSeq) && validSeq(b.messageSeq)) return a.messageSeq === b.messageSeq
+    return !!a.clientMsgNo && a.clientMsgNo === b.clientMsgNo
+}
+
+type Entry = { message: SnapshotMessage; index: number }
+
+function groupByAliases(entries: Entry[], ignored: Set<string>): Entry[][] {
+    const groups: Array<{ entries: Entry[]; aliases: Set<string> }> = []
+    for (const entry of entries) {
+        const aliases = new Set(keys(entry.message).filter(key => !ignored.has(key)))
+        const members = [entry]
+        // Existing groups have disjoint alias sets. Newly acquired aliases cannot
+        // hit an already skipped group, so a single reverse pass is sufficient.
+        for (let i = groups.length - 1; i >= 0; i--) {
+            if ([...aliases].some(key => groups[i].aliases.has(key))) {
+                for (const key of groups[i].aliases) aliases.add(key)
+                members.push(...groups[i].entries)
+                groups.splice(i, 1)
+            }
+        }
+        groups.push({ entries: members, aliases })
+    }
+    return groups.map(group => group.entries)
+}
+
+function identities(entries: Entry[]) {
+    return {
+        ids: new Set(entries.map(entry => entry.message.messageID).filter((id): id is string => !!id)),
+        seqs: new Set(entries.map(entry => entry.message.messageSeq).filter(validSeq)),
+    }
+}
+
+/** Shared by overlapping requests; discarded when the owning request settles. */
+export class HistorySnapshot<T extends SnapshotMessage> {
+    readonly arrivals: T[] = []
+    // Preserve identity context: flat tombstone aliases could delete an unrelated
+    // message that reuses a client number. Ambiguous aliases stay disabled for
+    // this request chain, even if only one of the conflicting rows arrives again.
+    private terminal = new Map<string, SnapshotMessage>()
+    private ambiguous = new Set<string>()
+
+    remember(messages: readonly SnapshotMessage[]): void {
+        for (const message of messages) {
+            if (!message.isDeleted && !message.revoke) continue
+            const identity = {
+                clientMsgNo: message.clientMsgNo || undefined,
+                messageID: message.messageID || undefined,
+                messageSeq: validSeq(message.messageSeq) ? message.messageSeq : undefined,
+            }
+            if (keys(identity).length === 0) continue
+            const key = JSON.stringify(identity)
+            const previous = this.terminal.get(key)
+            this.terminal.set(key, {
+                ...identity,
+                isDeleted: message.isDeleted || previous?.isDeleted,
+                revoke: message.revoke || previous?.revoke,
+                revoker: message.revoker ?? previous?.revoker,
+            })
+        }
+    }
+
+    remove(messages: readonly SnapshotMessage[]): void {
+        this.remember(messages.map(message => ({
+            messageID: message.messageID, messageSeq: message.messageSeq,
+            clientMsgNo: message.clientMsgNo, isDeleted: true,
+        })))
+    }
+
+    revoke(messageID: string, revoker?: string): void {
+        if (messageID) this.remember([{ messageID, revoke: true, revoker }])
+    }
+
+    merge(messages: readonly T[]): T[] {
+        this.remember(messages)
+        const entries: Entry[] = messages.map((message, index) => ({ message, index }))
+        entries.push(...Array.from(this.terminal.values(), message => ({ message, index: -1 })))
+        let groups = groupByAliases(entries, this.ambiguous)
+        let ignoredCount = this.ambiguous.size
+        for (const group of groups) {
+            const { ids, seqs } = identities(group)
+            if (ids.size > 1 || seqs.size > 1) {
+                // Do not guess which server message an ambiguous client belongs to.
+                for (const { message } of group) {
+                    if (message.clientMsgNo) this.ambiguous.add(`client:${message.clientMsgNo}`)
+                }
+            }
+        }
+        if (this.ambiguous.size !== ignoredCount) groups = groupByAliases(entries, this.ambiguous)
+        ignoredCount = this.ambiguous.size
+        for (const group of groups) {
+            if (identities(group).ids.size > 1) {
+                // Server ID is canonical when sequence itself has conflicting IDs.
+                for (const { message } of group) {
+                    if (validSeq(message.messageSeq)) this.ambiguous.add(`seq:${message.messageSeq}`)
+                }
+            }
+        }
+        if (this.ambiguous.size !== ignoredCount) groups = groupByAliases(entries, this.ambiguous)
+        const result: Array<{ message: T; index: number }> = []
+        for (const group of groups) {
+            const index = Math.max(...group.map(entry => entry.index))
+            const deleted = group.some(entry => entry.message.isDeleted)
+            const revoked = group.some(entry => entry.message.revoke)
+            const revoker = group.find(entry => entry.message.revoke && entry.message.revoker !== undefined)?.message.revoker
+            if (deleted || revoked) {
+                const { ids, seqs } = identities(group)
+                // Qualify learned aliases so future collisions cannot inherit state.
+                this.remember(group.map(({ message }) => ({
+                    messageID: message.messageID || (ids.size === 1 ? [...ids][0] : undefined),
+                    messageSeq: validSeq(message.messageSeq) ? message.messageSeq : (seqs.size === 1 ? [...seqs][0] : undefined),
+                    clientMsgNo: message.clientMsgNo,
+                    isDeleted: deleted, revoke: revoked, revoker,
+                })))
+            }
+            if (deleted || index < 0) continue
+            const message = messages[index]
+            if (revoked) {
+                message.revoke = true
+                message.revoker = revoker
+            }
+            result.push({ message, index })
+        }
+        return result.sort((a, b) => a.index - b.index).map(entry => entry.message)
+    }
+}
