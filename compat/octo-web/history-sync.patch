+// @vitest-environment node
+import { describe, expect, it } from "vitest"
+import { HistorySnapshot, sameSnapshotMessage, type SnapshotMessage } from "./historySnapshot"
+
+const file = (): SnapshotMessage => ({ messageID: "101", messageSeq: 101, clientMsgNo: "file" })
+const text = (): SnapshotMessage => ({ messageID: "102", messageSeq: 102, clientMsgNo: "text" })
+
+describe("in-flight history snapshot reconciliation", () => {
+    it("retains a distinct live final after the file snapshot without copying older history", () => {
+        const snapshot = new HistorySnapshot<SnapshotMessage>()
+        snapshot.remember([{ messageID: "1", messageSeq: 1, clientMsgNo: "old" }])
+        snapshot.arrivals.push(text())
+        expect(snapshot.merge([file(), ...snapshot.arrivals]).map(m => m.messageSeq)).toEqual([101, 102])
+    })
+
+    it("deduplicates REST/WS copies even when a client number changes", () => {
+        const snapshot = new HistorySnapshot<SnapshotMessage>()
+        const live = { ...text(), clientMsgNo: "different" }
+        expect(snapshot.merge([file(), text(), live])).toEqual([file(), live])
+    })
+
+    it("accepts positive server sequence as an identity but never conflates empty keys", () => {
+        expect(sameSnapshotMessage({ messageSeq: 102 }, text())).toBe(true)
+        expect(sameSnapshotMessage({ clientMsgNo: "" }, { clientMsgNo: "" })).toBe(false)
+        expect(sameSnapshotMessage({ messageSeq: 0 }, { messageSeq: 0 })).toBe(false)
+        expect(new HistorySnapshot().merge([{}, {}])).toHaveLength(2)
+    })
+
+    it("keeps local deletion tombstones across repeated overlapping-snapshot merges", () => {
+        const snapshot = new HistorySnapshot<SnapshotMessage>()
+        snapshot.arrivals.push(text())
+        snapshot.remove([text()])
+        expect(snapshot.merge([file(), ...snapshot.arrivals])).toEqual([file()])
+        expect(snapshot.merge([file(), text(), ...snapshot.arrivals])).toEqual([file()])
+    })
+
+    it("does not revive a deleted snapshot row through a stale live alias", () => {
+        const snapshot = new HistorySnapshot<SnapshotMessage>()
+        snapshot.remember([{ ...text(), clientMsgNo: "server-alias", isDeleted: true }])
+        expect(snapshot.merge([file(), text()])).toEqual([file()])
+    })
+
+    it("retains revocation received before the message has loaded", () => {
+        const snapshot = new HistorySnapshot<SnapshotMessage>()
+        snapshot.revoke("102", "moderator")
+        expect(snapshot.merge([text()])[0]).toMatchObject({ revoke: true, revoker: "moderator" })
+    })
+
+    it("preserves known revocation when a stale snapshot or live copy says otherwise", () => {
+        const snapshot = new HistorySnapshot<SnapshotMessage>()
+        snapshot.remember([{ ...text(), revoke: true, revoker: "moderator" }])
+        const merged = snapshot.merge([{ ...text(), revoke: false }, { ...text(), clientMsgNo: "alias" }])
+        expect(merged).toHaveLength(1)
+        expect(merged[0]).toMatchObject({ revoke: true, revoker: "moderator" })
+    })
+
+    it("keeps deletion stronger than revocation across identity aliases", () => {
+        const snapshot = new HistorySnapshot<SnapshotMessage>()
+        snapshot.remove([{ messageID: "102" }])
+        const merged = snapshot.merge([
+            { messageID: "102", clientMsgNo: "alias", revoke: true },
+            { clientMsgNo: "alias", messageSeq: 102 },
+        ])
+        expect(merged).toEqual([])
+        expect(snapshot.merge([{ messageSeq: 102 }])).toEqual([])
+    })
+
+    it.each([NaN, Infinity, -Infinity, -1, 0, 1.5, Number.MAX_SAFE_INTEGER + 1, "102" as unknown as number])(
+        "does not use invalid sequence %s as an identity or tombstone alias", seq => {
+            const snapshot = new HistorySnapshot<SnapshotMessage>()
+            expect(sameSnapshotMessage({ messageSeq: seq }, { messageSeq: seq })).toBe(false)
+            expect(snapshot.merge([{ messageSeq: seq }, { messageSeq: seq }])).toHaveLength(2)
+            snapshot.remove([{ messageID: "deleted", messageSeq: seq }])
+            expect(snapshot.merge([{ messageID: "other", messageSeq: seq }])).toHaveLength(1)
+        })
+
+    it("uses safe positive sequence and canonical server ID in comparisons", () => {
+        expect(sameSnapshotMessage({ messageSeq: Number.MAX_SAFE_INTEGER }, { messageSeq: Number.MAX_SAFE_INTEGER })).toBe(true)
+        expect(sameSnapshotMessage({ messageID: "1", messageSeq: 1 }, { messageID: "1", messageSeq: 2 })).toBe(true)
+        const pairs: [SnapshotMessage, SnapshotMessage][] = [
+            [{ messageID: "1", clientMsgNo: "same" }, { messageID: "2", clientMsgNo: "same" }],
+            [{ messageSeq: 1, clientMsgNo: "same" }, { messageSeq: 2, clientMsgNo: "same" }],
+            [{ messageID: "1", messageSeq: 1 }, { messageID: "2", messageSeq: 1 }],
+        ]
+        for (const [a, b] of pairs) {
+            expect(sameSnapshotMessage(a, b)).toBe(false)
+            expect(sameSnapshotMessage(b, a)).toBe(false)
+            expect(new HistorySnapshot().merge([a, b])).toEqual([a, b])
+        }
+    })
+
+    it("still matches valid identities when the sequence is invalid, without mixing key namespaces", () => {
+        expect(sameSnapshotMessage({ clientMsgNo: "c", messageSeq: Infinity }, { clientMsgNo: "c", messageSeq: NaN })).toBe(true)
+        expect(sameSnapshotMessage({ messageID: "1" }, { clientMsgNo: "1" })).toBe(false)
+        expect(sameSnapshotMessage({ messageID: "1" }, { messageSeq: 1 })).toBe(false)
+    })
+
+    it("deduplicates one canonical server ID even if its sequence differs", () => {
+        const a = { messageID: "1", messageSeq: 1, clientMsgNo: "old" }
+        const b = { messageID: "1", messageSeq: 2, clientMsgNo: "new" }
+        expect(new HistorySnapshot().merge([a, b])).toEqual([b])
+    })
+
+    it("joins disjoint groups through a late alias bridge in every input order", () => {
+        const rows = [{ messageID: "1" }, { messageSeq: 1 }, { clientMsgNo: "c", messageID: "1" }, { clientMsgNo: "c", messageSeq: 1 }]
+        for (const order of permutations(rows)) {
+            expect(new HistorySnapshot().merge(order)).toEqual([order[order.length - 1]])
+        }
+    })
+
+    it("never lets a partial alias bridge collapse conflicting server messages", () => {
+        const a = { messageID: "1", messageSeq: 1, clientMsgNo: "a" }
+        const b = { messageID: "2", messageSeq: 2, clientMsgNo: "b" }
+        const bridge = { messageSeq: 1, clientMsgNo: "b" }
+        for (const order of permutations([a, b, bridge])) {
+            const merged = new HistorySnapshot().merge(order)
+            expect(merged).toHaveLength(2)
+            expect(merged).toContain(b)
+            expect(merged.filter(message => message.messageSeq === 1)).toHaveLength(1)
+        }
+    })
+
+    it.each(["deleted", "revoked"])("does not transfer %s state through a reused client number", state => {
+        const snapshot = new HistorySnapshot<SnapshotMessage>()
+        const a = { ...file(), clientMsgNo: "same" }
+        const b = { ...text(), clientMsgNo: "same" }
+        if (state === "deleted") snapshot.remove([a])
+        else snapshot.remember([{ ...a, revoke: true, revoker: "moderator" }])
+        for (const input of [[a, b], [b], [a, b]]) {
+            const merged = snapshot.merge(input.map(message => ({ ...message })))
+            const kept = merged.find(message => message.messageID === "102")
+            expect(kept).toBeDefined()
+            expect(kept?.revoke).not.toBe(true)
+            if (state === "deleted") expect(merged.some(message => message.messageID === "101")).toBe(false)
+            else if (input.length > 1) expect(merged.find(message => message.messageID === "101")?.revoke).toBe(true)
+        }
+    })
+
+    it("qualifies learned terminal aliases before a later conflicting arrival", () => {
+        const snapshot = new HistorySnapshot<SnapshotMessage>()
+        snapshot.remove([{ messageID: "101" }])
+        expect(snapshot.merge([{ ...file(), clientMsgNo: "shared" }])).toEqual([])
+        expect(snapshot.merge([{ ...text(), clientMsgNo: "shared" }])).toHaveLength(1)
+        expect(snapshot.merge([{ messageSeq: 101 }])).toEqual([])
+        expect(snapshot.merge([file()])).toEqual([])
+    })
+
+    it("does not transfer terminal state through conflicting sequence identities", () => {
+        const snapshot = new HistorySnapshot<SnapshotMessage>()
+        snapshot.revoke("101", "moderator")
+        snapshot.merge([file()])
+        const b = { messageID: "other", messageSeq: 101 }
+        expect(snapshot.merge([b])[0].revoke).not.toBe(true)
+        expect(snapshot.merge([file()])[0].revoke).toBe(true)
+    })
+
+    it("keeps an ambiguous weak tombstone disabled on later merges", () => {
+        const snapshot = new HistorySnapshot<SnapshotMessage>()
+        snapshot.remove([{ clientMsgNo: "same" }])
+        const a = { ...file(), clientMsgNo: "same" }
+        const b = { ...text(), clientMsgNo: "same" }
+        expect(snapshot.merge([a, b])).toEqual([a, b])
+        expect(snapshot.merge([b])).toEqual([b])
+    })
+})
+
+function permutations<T>(items: T[]): T[][] {
+    if (items.length === 0) return [[]]
+    return items.flatMap((item, index) => permutations(items.filter((_, i) => i !== index)).map(rest => [item, ...rest]))
+}
diff --git a/packages/dmworkbase/src/Components/Conversation/historySnapshot.ts b/packages/dmworkbase/src/Components/Conversation/historySnapshot.ts
