diff --git a/tests/sidebar-channel-source.test.mjs b/tests/sidebar-channel-source.test.mjs
new file mode 100644
index 0000000..585baa9
--- /dev/null
+++ b/tests/sidebar-channel-source.test.mjs
@@ -0,0 +1,42 @@
+import assert from 'node:assert/strict'
+import { readFileSync } from 'node:fs'
+import test from 'node:test'
+import { extractBlock } from './sidebar-lifecycle-harness.mjs'
+
+const src = readFileSync(new URL('../client.js', import.meta.url), 'utf8')
+const code = extractBlock(src, '    const channelSourceRegistries', '    function syntheticChannelWorkspaceState', 'channel source bridge')
+const { channelSourcesFor, projectExternalGroups } = new Function('CHANNEL_GROUP_IDS', code
+  + '; return { channelSourcesFor, projectExternalGroups }')(['weixin'])
+
+test('external Octo source groups real sessions and disappears on uninstall without touching IM Connect data', () => {
+  const registry = {}, bridge = channelSourcesFor(registry), listeners = new Set()
+  let rows = []
+  const register = bridge.register({ id: 'octo', label: 'Octo', getSnapshot: () => rows,
+    subscribe(fn) { listeners.add(fn); return () => listeners.delete(fn) } })
+  let notifications = 0
+  bridge.subscribe(() => notifications++)
+  rows = [
+    { id: 'main', path: [{ key: 'groups', label: 'Groups' }, { key: 'group:1', label: '同名群' }, { key: 'main', label: 'Main' }] },
+    { id: 'topic', path: [{ key: 'groups', label: 'Groups' }, { key: 'group:1', label: '同名群' }, { key: 'topic:3', label: 'Topic' }] },
+    { id: 'other', path: [{ key: 'groups', label: 'Groups' }, { key: 'group:2', label: '同名群' }, { key: 'main', label: 'Main' }] },
+    { id: 'wechat', path: [] }, { id: 'deleted', path: [] },
+  ]
+  for (const listener of listeners) listener()
+  const existing = [{ id: 'weixin', sessions: [{ sessionId: 'wechat' }] }]
+  const state = { byId: { main: {}, topic: {}, other: {}, wechat: {} } }
+  const groups = projectExternalGroups(existing, bridge.getSnapshot(), state)
+  assert.equal(groups[0], existing[0])
+  const channels = groups.filter(group => group.external)
+  assert.deepEqual(channels.filter(group => group.sessions.length).map(group => group.sessions[0].sessionId),
+    ['main', 'topic', 'other'])
+  const labels = channels.filter(group => group.label === '同名群')
+  assert.equal(labels.length, 2)
+  assert.notEqual(labels[0].path, labels[1].path)
+  assert.ok(channels.find(group => group.label === 'Topic').path.startsWith(labels[0].path + '/'))
+  register()
+  assert.equal(listeners.size, 0)
+  assert.deepEqual(bridge.getSnapshot(), [])
+  assert.equal(notifications, 2)
+  bridge.release()
+  assert.equal(registry.channelSources, undefined)
+})
